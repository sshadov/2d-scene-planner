{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.disguise-scene-planner/schemas/scene.schema.json",
  "title": "Disguise Scene Planner plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "units", "coordinateSystem", "room", "objects"],
  "properties": {
    "version": { "const": 4 },
    "units": { "const": "metres" },
    "coordinateSystem": { "const": "Designer XYZ; origin at room centre; top view X/Z" },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "depth": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/sceneObject" }
    }
  },
  "$defs": {
    "vector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "sceneObject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "type", "name", "position", "rotation", "verticalRef"],
      "properties": {
        "pluginId": { "type": "string", "minLength": 1 },
        "type": { "enum": ["screen", "surface", "camera", "projector", "light"] },
        "name": { "type": "string", "minLength": 1 },
        "position": { "$ref": "#/$defs/vector" },
        "rotation": { "$ref": "#/$defs/vector" },
        "verticalRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "to"],
          "properties": {
            "from": { "enum": ["floor", "stage"] },
            "to": { "enum": ["bottom", "center", "top"] }
          }
        },
        "designer": { "type": "object" }
      }
    }
  }
}
